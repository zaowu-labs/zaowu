{
  "name": "@zaowu-labs/cli",
  "version": "1.0.2",
  "description": "ZaoWu command-line interface",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zw": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "dev": "tsc -b --watch"
  },
  "dependencies": {
    "@zaowu-labs/ai": "workspace:*",
    "@zaowu-labs/auto": "workspace:*",
    "@zaowu-labs/config": "workspace:*",
    "@zaowu-labs/core": "workspace:*",
    "@zaowu-labs/data": "workspace:*",
    "@zaowu-labs/dev": "workspace:*",
    "@zaowu-labs/doc": "workspace:*",
    "@zaowu-labs/plugin": "workspace:*",
    "@zaowu-labs/teach": "workspace:*",
    "@zaowu-labs/web": "workspace:*"
  },
  "keywords": [
    "zaowu",
    "cli",
    "zw"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaowu-labs/zaowu.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/zaowu-labs/zaowu",
  "bugs": "https://github.com/zaowu-labs/zaowu/issues"
}
