{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zaowu.dev/zaowu.command.auto-run.schema.json",
  "title": "ZaoWu Auto Run Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "status",
    "filePath",
    "workflow",
    "policy",
    "sandbox",
    "executed",
    "skipped",
    "receipts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": ["ok", "preview"]
    },
    "filePath": {
      "type": "string"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "name", "variables", "permissions", "steps"]
    },
    "policy": {
      "$ref": "https://schemas.zaowu.dev/zaowu.command.shared.schema.json#/$defs/autoPolicy"
    },
    "sandbox": {
      "$ref": "https://schemas.zaowu.dev/zaowu.command.shared.schema.json#/$defs/autoSandbox"
    },
    "executed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["index", "name", "action", "status", "detail"],
        "properties": {
          "index": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "action": {
            "enum": ["message", "shell", "writeFile", "unsupported"]
          },
          "status": {
            "enum": ["executed", "skipped", "blocked"]
          },
          "detail": {
            "type": "string"
          },
          "targetPath": {
            "type": "string"
          },
          "contentSha256": {
            "type": "string"
          },
          "contentLength": {
            "type": "number"
          }
        }
      }
    },
    "operationPlan": {
      "$ref": "https://schemas.zaowu.dev/zaowu.command.shared.schema.json#/$defs/operationPlan"
    }
  }
}
